@model IEnumerable<RDMA_Graduation_Prep.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<div class="dashboard-background">

    <h2>Student List</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Student</a>
    </p>

    <!-- Search bar -->
    <form method="get" class="mb-3 d-flex gap-2">
        <input type="text" name="searchQuery" class="form-control" style="max-width: 300px;" value="@ViewBag.SearchQuery" placeholder="Search by Name, Class, Belt..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <table class="table table-striped table-bordered table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Class Name</th>
                <th>Current Belt</th>
                <th>Stripe Count</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.LastName</td>
                    <td>@student.FirstName</td>
                    <td>@student.ClassName</td>
                    <td>@student.CurrentBelt</td>
                    <td>@student.StripeCount</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-secondary">Previous</a>
        }

        <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-secondary">Next</a>
        }
    </div>

</div>
